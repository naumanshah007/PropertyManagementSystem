APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://quote.privexa.co

DATABASE_PROVIDER=json

FILE_STORAGE_PROVIDER=local

# Auth — signed access tokens (HS256). REQUIRED in production (the app refuses
# to start without it). In local dev a built-in dev secret is used if unset.
AUTH_SECRET=dev-only-insecure-tracequote-auth-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo bootstrap — keep true for the controlled hosted demo, false to lock down.
DEMO_SEED_ENABLED=true
DEMO_ADMIN_EMAIL=admin@privexa.co
DEMO_ADMIN_PASSWORD=admin123
DEMO_ORG_ADMIN_EMAIL=test@privexa.co
DEMO_ORG_ADMIN_PASSWORD=admin123
